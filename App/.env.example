# Mesmo banco de dados SQL Server da fazenda que o admin_fazenda_progresso-main usa — este é
# um projeto Vercel separado, então precisa da própria cópia dessas variáveis configurada lá.
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
MSSQL_CONNECTION_TIMEOUT_MS=15000

# Opcional: só necessário se quiser apontar para outro host que não o das próprias serverless
# functions deste projeto (api/*.ts). Deixe vazio para usar caminho relativo.
# VITE_API_URL=http://localhost:3000
