# Opcional: só necessário se você quiser apontar para o backend Express em server/
# (npm run dev lá) em vez das serverless functions em api/. Deixe vazio/removido
# para usar caminho relativo (funciona com `vercel dev` e em produção no Vercel).
# VITE_API_URL=http://localhost:3333

# Painel de Insights (IA) — api/insights/gerar.ts chama a OpenAI pra ler os dados
# agregados de Metas/Gastos/Alarmes e sugerir insights. Sem isso, o botão "Gerar
# novos insights" retorna 502.
OPENAI_API_KEY=
# Opcional — default gpt-4o-mini se não definido.
OPENAI_MODEL=gpt-4o-mini

# Módulo de Estoque — mesmo gateway OAuth2 utilizado pelo sistema de estoque
# original. Cadastre estes valores somente nas variáveis de ambiente da Vercel.
SANKHYA_API_URL=https://api.sankhya.com.br
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
SANKHYA_X_TOKEN=
